extends layout

block content
  .toolbar
    h2 Lista de Lotes

  .table-container
    table
      tr
        th Código
        th Producto
        th Proveedor
        th Fecha Ingreso
        th Fecha Vencimiento
        th Disponible
        th Inicial
        th Estado
        th Acciones

      each lote in lotes
        tr
          td= lote.codigoLote
          td= lote.producto ? lote.producto.nombre : "-"
          td= lote.proveedor ? lote.proveedor.nombre : "-"
          td= new Date(lote.fechaIngreso).toLocaleDateString()
          td= new Date(lote.fechaVencimiento).toLocaleDateString()
          td= lote.cantidadDisponible
          td= lote.cantidadInicial
          td= lote.estado
          td
            a.btn-action(href=`/lotes/vista/${lote.id}`) Ver
            button.btn-action.btn-danger(type="button", data-id=lote.id) Eliminar

  script.
    document.querySelectorAll('button[data-id]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este lote?')) return;
        const response = await fetch(`/lotes/${btn.dataset.id}`, { method: 'DELETE' });
        if (response.ok) window.location.reload();
        else alert('Error al eliminar lote');
      });
    });
