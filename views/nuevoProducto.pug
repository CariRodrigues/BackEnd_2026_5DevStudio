extends ./layout

block content
  .card-container
    .card-header
      h1 Nuevo Producto

    form(method="POST", action="/productos")
      .form-group
        div
          label Nombre:
          input(type="text", name="nombre", required)
      .form-group
        div
          label Descripción:
          textarea(name="descripcion", rows="2")
      .form-group
        div
          label Marca:
          input(type="text", name="marca", required)
      .form-group
        div
          label Precio:
          input(type="number", name="precio", required, min="0.01", step="0.01")
      .form-group
        div
          label Proveedor:
          select(name="proveedorId", required)
            option(value="") - Seleccionar Proveedor -
            each proveedor in proveedores
              option(value=proveedor.id)= proveedor.nombre
      .form-actions
        button.button.btn-success(type="submit") Guardar
        a.button(href="/productos/vista") Volver
