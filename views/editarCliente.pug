extends ./layout

block content
  .card-container
    .card-header
      h1 Editar Cliente

    form(method="POST", action=`/clientes/${cliente.id}/editar`)
      .form-group
        div
          label Nombre:
          input(type="text", name="nombre", value=cliente.nombre, required)
      .form-group
        div
          label Email:
          input(type="email", name="email", value=cliente.email, required)
      .form-group
        div
          label Teléfono:
          input(type="text", name="telefono", value=cliente.telefono)
      .form-group
        div
          label Dirección:
          input(type="text", name="direccion", value=cliente.direccion)
      .form-group
        div
          label Activo:
          input(type="checkbox", name="activo", checked=cliente.activo)
      .form-group
        div
          label Notas:
          textarea(name="notas", rows="2")= cliente.notas
      .form-actions
        button.button.btn-success(type="submit") Guardar cambios
        a.button(href="/clientes/vista") Volver
