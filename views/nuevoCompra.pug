extends layout

block content
  h2 Registrar compra

  form(method="POST", action="/compras")
    label Proveedor:
    select(name="proveedorId", required)
      option(value="") - Seleccionar proveedor -
      each proveedor in proveedores
        option(value=proveedor._id)= proveedor.nombre

    br
    br

    label Producto:
    select(name="productoId", required)
      option(value="") - Seleccionar producto -
      each producto in productos
        option(value=producto._id, data-precio=producto.precio)= producto.nombre

    p Precio del producto seleccionado: 
      strong(id="precioProducto") -

    br
    br

    label Cantidad:
    input(type="number", name="cantidad", required, min="1")

    br
    br

    label Precio de compra:
    input(type="number", step="0.01", name="precioCompra", required, min="0")

    br
    br

    label Fecha de vencimiento:
    input(type="date", name="fechaVencimiento", required)

    br
    br

    label Observación:
    textarea(name="observacion", rows="3")

    br
    br

    button(type="submit") Guardar

    |
    |

    a(href="/compras/vista") Volver

  script.
    const productoSelect = document.querySelector('select[name="productoId"]');
    const precioProducto = document.getElementById('precioProducto');
    const precioCompraInput = document.querySelector('input[name="precioCompra"]');

    function actualizarPrecioCompra() {
      const opcion = productoSelect.options[productoSelect.selectedIndex];
      const precio = opcion && opcion.dataset.precio ? parseFloat(opcion.dataset.precio) : null;
      if (precio !== null && !isNaN(precio)) {
        precioProducto.textContent = '$' + precio.toFixed(2);
        if (precioCompraInput) precioCompraInput.value = precio.toFixed(2);
      } else {
        precioProducto.textContent = '-';
      }
    }

    productoSelect.addEventListener('change', actualizarPrecioCompra);
    actualizarPrecioCompra();

