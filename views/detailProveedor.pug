doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Dettale del Producto
    link(rel="stylesheet", href="/styles.css")
  body
    .header-top
        h1 Todo Stock
        .actions-group
          a.button(href="/productos/vista") Ver productos
          a.button(href="/proveedores/vista") Ver proveedores
          a.button(href="/productos/nuevo") Nuevo producto
          a.button(href="/proveedores/nuevo") Nuevo proveedor

        h2 Detalle del Proveedor

        p
          strong ID: 
          = proveedor.id

        p
          strong CUIT: 
          = proveedor.cuit

        p
          strong Nombre: 
          = proveedor.nombre

        p
          strong Domicilio: 
          = proveedor.domicilio

        p
          strong Telofono: 
          = proveedor.telefono

        p
          strong Email: 
          = proveedor.email

        p
          strong Rubro: 
          = proveedor.rubro

        p
          strong Plazo de Entrega: 
          = proveedor.plazoEntrega + " dias"

        p
          strong Activo: 
          = proveedor.activo ? "Si" : "No"

        p
          strong Observaciones: 
          = proveedor.observaciones || "Sin observaciones"

        .form-actions
            a.button(href="/proveedores/vista") Volver al listado
