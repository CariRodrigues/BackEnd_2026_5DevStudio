extends layout

block content
  .toolbar
    h2 Lista de Clientes
    a.button.btn-success(href="/clientes/nuevo") Nuevo Cliente

  .table-container
    table
      tr
        th Nombre
        th Email
        th Teléfono
        th Activo
        th Saldo Cuenta Corriente
        th Acciones

      each cliente in clientes
        tr
          td= cliente.nombre
          td= cliente.email
          td= cliente.telefono || "-"
          td= cliente.activo ? "Sí" : "No"
          td $#{cliente.saldoCuentaCorriente.toFixed(2)}
          td
            a.btn-action(href=`/clientes/vista/${cliente.id}`) Ver
            a.btn-action(href=`/clientes/editar/${cliente.id}`) Editar
            a.btn-action(href=`/clientes/vista/${cliente.id}/movimientos`) Movimientos
            button.btn-action.btn-danger(type="button", data-id=cliente.id) Eliminar

  script.
    document.querySelectorAll('button[data-id]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este cliente?')) return;
        const response = await fetch(`/clientes/${btn.dataset.id}`, { method: 'DELETE' });
        if (response.ok) window.location.reload();
        else alert('Error al eliminar cliente');
      });
    });
