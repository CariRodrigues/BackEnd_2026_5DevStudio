extends ../layout

block content

  h2 Detalle del Cliente

  p
    strong ID: 
    = cliente.id

  p
    strong CUIT: 
    = cliente.cuit

  p
    strong Condición IVA: 
    = cliente.condicionIVA

  p
    strong Nombre: 
    = cliente.nombre

  p
    strong Apellido: 
    = cliente.apellido

  p
    strong Domicilio: 
    = cliente.domicilio

  p
    strong Teléfono: 
    = cliente.telefono

  p
    strong Email: 
    = cliente.email

  p
    strong Observaciones: 
    = cliente.observaciones || "Sin observaciones"

  br

  a(href="/clientes/vista") Volver al listado
