extends ./layout

block content
  .card-container
    .card-header
      h1 Detalle del Proveedor

    .form-group
      strong CUIT:
      |  #{proveedor.cuit}
    .form-group
      strong Nombre:
      |  #{proveedor.nombre}
    .form-group
      strong Categoría:
      |  #{proveedor.categoria}
    .form-group
      strong Domicilio:
      |  #{proveedor.domicilio || "-"}
    .form-group
      strong Teléfono:
      |  #{proveedor.telefono || "-"}
    .form-group
      strong Email:
      |  #{proveedor.email || "-"}
    .form-group
      strong Plazo de Entrega:
      |  #{proveedor.plazoEntrega} días
    .form-group
      strong Activo:
      |  #{proveedor.activo ? "Sí" : "No"}
    .form-group
      strong Observaciones:
      |  #{proveedor.observaciones || "-"}

    .form-actions
      a.button(href=`/proveedores/editar/${proveedor.id}`) Editar
      a.button(href="/proveedores/vista") Volver
