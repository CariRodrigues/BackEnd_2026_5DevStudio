extends layout

block content
  .toolbar
    h2 Compras Registradas
    a.button.btn-success(href="/compras/nuevo") Nueva Compra

  .table-container
    table
      tr
        th Proveedor
        th Producto
        th Lote
        th Cantidad
        th Precio Compra
        th Fecha
        th Observación

      each compra in compras
        tr
          td= compra.proveedor ? compra.proveedor.nombre : "-"
          td= compra.producto ? compra.producto.nombre : "-"
          td= compra.lote ? compra.lote.codigoLote : "-"
          td= compra.cantidad
          td= compra.precioCompra
          td= compra.fecha ? new Date(compra.fecha).toLocaleDateString() : "-"
          td= compra.observacion || "-"
