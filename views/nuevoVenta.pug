extends layout

block content
  h2 Registrar venta

  form(method="POST", action="/ventas")
    label Cliente:
    select(name="clienteId", required)
      option(value="") - Seleccionar cliente -
      each cliente in clientes
        option(value=cliente._id)= cliente.nombre

    br
    br

    label Producto:
    select(name="productoId", required, id="productoSelect")
      option(value="") - Seleccionar producto -
      each producto in productos
        option(value=producto._id, data-stock=producto.stock)= producto.nombre

    br

    label(id="stockLabel") Stock disponible: -

    br
    br

    label Cantidad:
    input(type="number", name="cantidad", required, min="1")

    br
    br

    label Precio de venta:
    input(type="number", step="0.01", name="precioVenta", required, min="0")

    br
    br

    label Observación:
    textarea(name="observacion", rows="3")

    br
    br

    button(type="submit") Guardar
    |  
    a(href="/ventas/vista") Volver

  script.
    const select = document.getElementById('productoSelect');
    const stockLabel = document.getElementById('stockLabel');
    select.addEventListener('change', () => {
      const stock = select.options[select.selectedIndex].dataset.stock || 0;
      stockLabel.textContent = `Stock disponible: ${stock}`;
    });
