extends layout

block content

  h2 Lista de productos

  a(href="/productos/nuevo") Nuevo Producto

  table(border="1")
    tr
      th ID
      th Nombre
      th Marca
      th Precio
      th Proveedor
      th Acciones

    each producto in productos
      tr
        td= producto.id
        td= producto.nombre
        td= producto.marca
        td= producto.precio
        td= producto.proveedorId ? producto.proveedorId.nombre : "-"
        td
          a(href=`/productos/vista/${producto.id}`) Ver
          |  
          a(href=`/productos/editar/${producto.id}`) Editar
          |  
          button(type="button" class="btn-delete" data-id=producto.id) Eliminar

  script.
    document.querySelectorAll('.btn-delete').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        if (!confirm('¿Eliminar este producto?')) return;
        const response = await fetch(`/productos/${id}`, { method: 'DELETE' });
        if (response.ok) {
          window.location.reload();
        } else {
          const errorData = await response.json().catch(() => ({}));
          alert(errorData.message || 'Error al eliminar producto');
        }
      });
    });