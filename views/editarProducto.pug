extends layout

block content
  h2 Editar Producto

  form(method="POST", action=`/productos/${producto.id}/editar`)

    label Nombre:
    input(type="text", name="nombre", value=producto.nombre, required)

    br
    br

    label Marca:
    input(type="text", name="marca", value=producto.marca, required)

    br
    br

    label Precio:
    input(type="number", name="precio", value=producto.precio, required)

    br
    br

    label Stock:
    input(type="number", name="stock", value=producto.stock, required)

    br
    br

    label Proveedor: 
    select(name="proveedorId" id="proveedorId" required)
      option(value="") - Seleccionar Proveedor -
      each proveedor in proveedores
        option(value=proveedor._id selected=(proveedor._id.toString() === proveedorSeleccionado))= proveedor.nombre

    br
    br

    button(type="submit") Guardar cambios

    |
    |

    a(href="/productos/vista") Volver al listado
