extends ./layout

block content
    .header-top
        h2 Detalle del Producto

        p
          strong Nombre:
          | #{producto.nombre}

        p
          strong Marca:
          | #{producto.marca}

        p
          strong Precio:
          | #{producto.precio}

        p
          strong Stock:
          | #{producto.stock}

        p
          strong Proveedor:
          | #{nombreProveedor}
        .form-actions
          a.button(href="/productos/vista") Volver
