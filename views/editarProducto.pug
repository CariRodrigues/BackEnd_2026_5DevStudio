extends layout

block content
  h2 Editar producto

  form(id="editProductoForm")
    label Nombre: 
    input(type="text" name="nombre" id="nombre" required value=producto.nombre)

    br
    br

    label Descripción: 
    textarea(name="descripcion" id="descripcion")= producto.descripcion

    br
    br

    label Marca: 
    input(type="text" name="marca" id="marca" required value=producto.marca)

    br
    br

    label Precio: 
    input(type="number" name="precio" id="precio" required min="0.01" step="0.01" value=producto.precio)

    br
    br

    label Proveedor: 
    select(name="proveedorId" id="proveedorId" required)
      option(value="") - Seleccionar Proveedor -
      each proveedor in proveedores
        option(value=proveedor._id selected=(proveedor._id.toString() === proveedorSeleccionado))= proveedor.nombre

    br
    br

    button(type="submit") Guardar cambios
    |
    |
    a(href="/productos/vista") Volver

  script.
    const productoId = "#{producto.id}";
    const form = document.getElementById('editProductoForm');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = {
        nombre: form.nombre.value,
        descripcion: form.descripcion.value,
        marca: form.marca.value,
        precio: Number(form.precio.value),
        proveedorId: form.proveedorId.value,
      };

      const response = await fetch(`/productos/${productoId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.href = '/productos/vista';
      } else {
        const errorData = await response.json().catch(() => ({}));
        alert(errorData.message || 'Error al actualizar producto');
      }
    });
