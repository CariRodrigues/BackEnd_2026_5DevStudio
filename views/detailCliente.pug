extends ./layout

block content
  .card-container
    .card-header
      h1 Detalle del Cliente

    .form-group
      strong Nombre:
      |  #{cliente.nombre}
    .form-group
      strong Email:
      |  #{cliente.email}
    .form-group
      strong Teléfono:
      |  #{cliente.telefono || "-"}
    .form-group
      strong Dirección:
      |  #{cliente.direccion || "-"}
    .form-group
      strong Activo:
      |  #{cliente.activo ? "Sí" : "No"}
    .form-group
      strong Fecha de registro:
      |  #{new Date(cliente.fechaRegistro).toLocaleDateString()}
    .form-group
      strong Última compra:
      |  #{cliente.ultimaCompra ? new Date(cliente.ultimaCompra).toLocaleDateString() : "Sin compras"}
    .form-group
      strong Saldo cuenta corriente:
      |  $#{cliente.saldoCuentaCorriente.toFixed(2)}
    .form-group
      strong Notas:
      |  #{cliente.notas || "-"}

    .form-actions
      a.button(href=`/clientes/vista/${cliente.id}/movimientos`) Movimientos
      a.button(href=`/clientes/editar/${cliente.id}`) Editar
      a.button(href="/clientes/vista") Volver
