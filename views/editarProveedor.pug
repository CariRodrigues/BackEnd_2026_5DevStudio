extends layout

block content
  h2 Editar proveedor

  form(id="editProveedorForm")
    label CUIT: 
    input(type="text" name="cuit" id="cuit" required value=proveedor.cuit)

    br
    br

    label Nombre: 
    input(type="text" name="nombre" id="nombre" required value=proveedor.nombre)

    br
    br

    label Domicilio: 
    input(type="text" name="domicilio" id="domicilio" required value=proveedor.domicilio)

    br
    br

    label Teléfono: 
    input(type="text" name="telefono" id="telefono" required value=proveedor.telefono)

    br
    br

    label Email: 
    input(type="email" name="email" id="email" required value=proveedor.email)

    br
    br

    label Categoría: 
    input(type="text" name="categoria" id="categoria" value=proveedor.categoria)

    br
    br

    label Plazo de Entrega (días): 
    input(type="number" name="plazoEntrega" id="plazoEntrega" required min="0" value=proveedor.plazoEntrega)

    br
    br

    label Activo: 
    input(type="checkbox" name="activo" id="activo" checked=proveedor.activo)

    br
    br

    label Observaciones: 
    textarea(name="observaciones" id="observaciones")= proveedor.observaciones

    br
    br

    button(type="submit") Guardar cambios
    |
    |
    a(href="/proveedores/vista") Volver

  script.
    const proveedorId = "#{proveedor.id}";
    const form = document.getElementById('editProveedorForm');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = {
        cuit: form.cuit.value,
        nombre: form.nombre.value,
        domicilio: form.domicilio.value,
        telefono: form.telefono.value,
        email: form.email.value,
        categoria: form.categoria.value,
        plazoEntrega: Number(form.plazoEntrega.value),
        activo: form.activo.checked,
        observaciones: form.observaciones.value,
      };

      const response = await fetch(`/proveedores/${proveedorId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        window.location.href = '/proveedores/vista';
      } else {
        const errorData = await response.json().catch(() => ({}));
        alert(errorData.message || 'Error al actualizar proveedor');
      }
    });
