doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Lista de Proveedores
    link(rel="stylesheet", href="/styles.css")
  body.listas
    .header-top
      h2 Lista de proveedores
      .actions-group
          a.button(href="/productos/vista") Ver productos
          a.button(href="/proveedores/vista") Ver proveedores
          a.button(href="/productos/nuevo") Nuevo producto
          a.button(href="/proveedores/nuevo") Nuevo proveedor
    if mensaje
      script.
        (function () {
          var msg = !{JSON.stringify(mensaje)};
          alert(msg);
          var url = new URL(window.location);
          url.searchParams.delete('mensaje');
          window.history.replaceState({}, document.title, url.pathname + url.search);
        })();

    .table-container
      table
        tr
          th ID
          th CUIT
          th Nombre
          th Domicilio
          th Telofono
          th Email
          th Rubro
          th Plazo Entrega
          th Activo
          th Acciones
          th Editar

        each proveedor in proveedores
          tr
            td= proveedor.id
            td= proveedor.cuit
            td= proveedor.nombre
            td= proveedor.domicilio
            td= proveedor.telefono
            td= proveedor.email
            td= proveedor.rubro
            td= proveedor.plazoEntrega + ' dias'
            td= proveedor.activo ? 'Si' : 'No'
            td
              a(href=`/proveedores/vista/${proveedor.id}`) Ver
