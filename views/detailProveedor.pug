extends ./layout

block content
    .header-top

        h2 Detalle del Proveedor

        p
          strong CUIT: 
          = proveedor.cuit

        p
          strong Nombre: 
          = proveedor.nombre

        p
          strong Domicilio: 
          = proveedor.domicilio

        p
          strong Telofono: 
          = proveedor.telefono

        p
          strong Email: 
          = proveedor.email

        p
          strong Rubro: 
          = proveedor.rubro

  p
    strong Categoría: 
    = proveedor.categoria

        p
          strong Activo: 
          = proveedor.activo ? "Si" : "No"

        p
          strong Observaciones: 
          = proveedor.observaciones || "Sin observaciones"

        .form-actions
            a.button(href="/proveedores/vista") Volver al listado
