html 
    head 
        title Login 
        link(rel="stylesheet" href="/styles.css")
        
    body 
        .login-container
            .login-header
                h1 ¡Bienvenido!
                p Por favor, ingresa tus datos para continuar.

            form(action="/usuarios/login" method="POST") 
                .form-group
                    div 
                        label(for="username") Usuario: 
                        input(type="text" name="username" required)
                    br
                .form-group
                    div 
                        label(for="password") Contraseña: 
                        input(type="password" name="password" required)
                    br
                .form-actions
                    button.submit-btn(type="submit") Ingresar 

            .login-footer
            p Realizado por 5DevStudio