html 
    head 
        title Login 
        link(rel="stylesheet" href="/styles.css")
        
    body 
        .login-container
            .login-header
                h1 ¡Bienvenido a TodoStock!
                p Por favor, ingresa tus datos para continuar.
            
            if error
                p(style="color: red") #{error}

            form(action="/auth/login" method="POST") 
                .form-group
                    div 
                        label(for="email") Email: 
                        input(type="email" name="email" required)
                    br
                .form-group
                    div 
                        label(for="password") Contraseña: 
                        input(type="password" name="password" required)
                    br
                .form-actions
                    button.submit-btn(type="submit") Ingresar 

            .login-footer
            p No tenes usuario?
              a(href="/auth/registro")  Registrate