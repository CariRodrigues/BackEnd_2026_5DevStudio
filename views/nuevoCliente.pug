extends ./layout

block content
  .card-container
    .card-header
      h1 Nuevo Cliente

    form(action="/clientes", method="POST")
      .form-group
        div
          label Nombre:
          input(type="text", name="nombre", required)
      .form-group
        div
          label Email:
          input(type="email", name="email", required)
      .form-group
        div
          label Teléfono:
          input(type="text", name="telefono")
      .form-group
        div
          label Dirección:
          input(type="text", name="direccion")
      .form-group
        div
          label Notas:
          textarea(name="notas", rows="2")
      .form-actions
        button.button.btn-success(type="submit") Guardar
        a.button(href="/clientes/vista") Volver
