extends layout

block content
  .toolbar
    h2 Historial de Movimientos

  .table-container
    if movimientos.length === 0
      p No hay movimientos registrados.
    else
      table
        tr
          th Fecha
          th Tipo
          th Producto
          th Lote
          th Cliente
          th Cantidad
          th Observación

        each movimiento in movimientos
          tr
            td= new Date(movimiento.fecha).toLocaleDateString()
            td= movimiento.tipo
            td= movimiento.producto ? movimiento.producto.nombre : "-"
            td= movimiento.lote ? movimiento.lote.codigoLote : (movimiento.detalles && movimiento.detalles.codigoLote ? movimiento.detalles.codigoLote : "-")
            td= movimiento.cliente ? movimiento.cliente.nombre : (movimiento.detalles && movimiento.detalles.clienteNombre ? movimiento.detalles.clienteNombre : "-")
            td= movimiento.cantidad
            td= movimiento.observacion || "-"
