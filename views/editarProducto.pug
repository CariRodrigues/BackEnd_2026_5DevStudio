extends ./layout

block content
  .card-container
    .card-header
      h1 Editar Producto

    form(method="POST", action=`/productos/${producto.id}/editar`)
      .form-group
        div
          label Nombre:
          input(type="text", name="nombre", value=producto.nombre, required)
      .form-group
        div
          label Descripción:
          textarea(name="descripcion", rows="2")= producto.descripcion
      .form-group
        div
          label Marca:
          input(type="text", name="marca", value=producto.marca, required)
      .form-group
        div
          label Precio:
          input(type="number", name="precio", value=producto.precio, required, min="0.01", step="0.01")
      .form-group
        div
          label Proveedor:
          select(name="proveedorId", required)
            option(value="") - Seleccionar Proveedor -
            each proveedor in proveedores
              option(value=proveedor._id, selected=(proveedor._id.toString() === proveedorSeleccionado))= proveedor.nombre
      .form-actions
        button.button.btn-success(type="submit") Guardar cambios
        a.button(href="/productos/vista") Volver
