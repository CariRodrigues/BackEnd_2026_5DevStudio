html 
    head 
        title Registro
        link(rel="stylesheet" href="/styles.css")
        
    body 
        .login-container
            .login-header
                h1 Registro de Usuario
                p Por favor, ingresa tus datos para continuar.
            
            if error
                p(style="color: red") #{error}

            form(action="/auth/registro" method="POST") 
                .form-group
                    div 
                        label(for="nombre") Nombre: 
                        input(type="text" name="nombre" required)
                    br
                .form-group
                    div 
                        label(for="email") Email: 
                        input(type="email" name="email" required)
                    br
                .form-group
                    div 
                        label(for="password") Contraseña: 
                        input(type="password" name="password" required)
                    br
                .form-actions
                    button.submit-btn(type="submit") Crear Usuario 
                    a.button(href="/productos/vista") Volver

            .login-footer
            p Ya tenes usuario?
              a(href="/auth/login")  Inicia Sesión