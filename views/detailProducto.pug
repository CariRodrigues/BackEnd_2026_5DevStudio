extends ./layout

block content
  .card-container
    .card-header
      h1 Detalle del Producto

    .form-group
      strong Nombre:
      |  #{producto.nombre}
    .form-group
      strong Descripción:
      |  #{producto.descripcion || "-"}
    .form-group
      strong Marca:
      |  #{producto.marca}
    .form-group
      strong Precio:
      |  $#{producto.precio}
    .form-group
      strong Proveedor:
      |  #{producto.proveedorId ? producto.proveedorId.nombre : "-"}

    .form-actions
      a.button(href=`/productos/editar/${producto.id}`) Editar
      a.button(href="/productos/vista") Volver
