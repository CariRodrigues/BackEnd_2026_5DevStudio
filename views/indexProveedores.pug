extends ./layout

block content
  .toolbar
    h2 Lista de Proveedores
    a.button(href="/proveedores/nuevo") Agregar Proveedor

  if mensaje
    script.
      (function () {
        var msg = !{JSON.stringify(mensaje)};
        alert(msg);
        var url = new URL(window.location);
        url.searchParams.delete('mensaje');
        window.history.replaceState({}, document.title, url.pathname + url.search);
      })();

  .table-container
    table
      tr
        th CUIT
        th Nombre
        th Domicilio
        th Telofono
        th Email
        th Rubro
        th Plazo Entrega
        th Activo
        th Acciones

      each proveedor in proveedores
        tr
          td= proveedor.cuit
          td= proveedor.nombre
          td= proveedor.domicilio
          td= proveedor.telefono
          td= proveedor.email
          td= proveedor.rubro
          td= proveedor.plazoEntrega + ' dias'
          td= proveedor.activo ? 'Si' : 'No'
          td
            a.btn-action(href=`/proveedores/vista/${proveedor.id}`) Ver
            |
            a.btn-action(href=`/proveedores/editar/${proveedor.id}`) Editar
