extends ./layout

block content
  .card-container
    .card-header
      h1 Editar Proveedor

    form(method="POST", action=`/proveedores/${proveedor.id}/editar`)
      .form-group
        div
          label CUIT:
          input(type="text", name="cuit", value=proveedor.cuit, required)
      .form-group
        div
          label Nombre:
          input(type="text", name="nombre", value=proveedor.nombre, required)
      .form-group
        div
          label Domicilio:
          input(type="text", name="domicilio", value=proveedor.domicilio)
      .form-group
        div
          label Teléfono:
          input(type="text", name="telefono", value=proveedor.telefono)
      .form-group
        div
          label Email:
          input(type="email", name="email", value=proveedor.email)
      .form-group
        div
          label Categoría:
          input(type="text", name="categoria", value=proveedor.categoria)
      .form-group
        div
          label Plazo de Entrega (días):
          input(type="number", name="plazoEntrega", value=proveedor.plazoEntrega)
      .form-group
        div
          label Activo:
          input(type="checkbox", name="activo", checked=proveedor.activo)
      .form-group
        div
          label Observaciones:
          textarea(name="observaciones", rows="2")= proveedor.observaciones
      .form-actions
        button.button.btn-success(type="submit") Guardar cambios
        a.button(href="/proveedores/vista") Volver
