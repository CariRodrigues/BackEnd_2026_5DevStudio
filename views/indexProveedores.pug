extends layout

block content
  .toolbar
    h2 Lista de Proveedores
    a.button.btn-success(href="/proveedores/nuevo") Nuevo Proveedor

  .table-container
    table
      tr
        th CUIT
        th Nombre
        th Categoría
        th Domicilio
        th Teléfono
        th Email
        th Plazo Entrega
        th Activo
        th Acciones

      each proveedor in proveedores
        tr
          td= proveedor.cuit
          td= proveedor.nombre
          td= proveedor.categoria
          td= proveedor.domicilio
          td= proveedor.telefono
          td= proveedor.email
          td= proveedor.plazoEntrega + ' días'
          td= proveedor.activo ? 'Sí' : 'No'
          td
            a.btn-action(href=`/proveedores/vista/${proveedor.id}`) Ver
            a.btn-action(href=`/proveedores/editar/${proveedor.id}`) Editar
            button.btn-action.btn-danger(type="button", data-id=proveedor.id) Eliminar

  script.
    document.querySelectorAll('button[data-id]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este proveedor?')) return;
        const response = await fetch(`/proveedores/${btn.dataset.id}`, { method: 'DELETE' });
        if (response.ok) window.location.reload();
        else alert('Error al eliminar proveedor');
      });
    });
