extends layout

block content

  h2 Lista de proveedores

  a(href="/proveedores/nuevo") Nuevo Proveedor

  table(border='1')
    tr
      th ID
      th CUIT
      th Nombre
      th Categoría
      th Domicilio
      th Telofono
      th Email
      th Plazo Entrega
      th Activo
      th Acciones

    each proveedor in proveedores
      tr
        td= proveedor.id
        td= proveedor.cuit
        td= proveedor.nombre
        td= proveedor.categoria
        td= proveedor.domicilio
        td= proveedor.telefono
        td= proveedor.email
        td= proveedor.plazoEntrega + ' dias'
        td= proveedor.activo ? 'Si' : 'No'
        td
          a(href=`/proveedores/vista/${proveedor.id}`) Ver
          |  
          a(href=`/proveedores/editar/${proveedor.id}`) Editar
          |  
          button(type="button" class="btn-delete" data-id=proveedor.id) Eliminar

  script.
    document.querySelectorAll('.btn-delete').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        if (!confirm('¿Eliminar este proveedor?')) return;
        const response = await fetch(`/proveedores/${id}`, { method: 'DELETE' });
        if (response.ok) {
          window.location.reload();
        } else {
          const errorData = await response.json().catch(() => ({}));
          alert(errorData.message || 'Error al eliminar proveedor');
        }
      });
    });
